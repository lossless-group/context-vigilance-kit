---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SearchBox from '@components/SearchBox.astro';
import CommandSteps from '@components/CommandSteps.astro';
import RecommendedFlow from '@components/RecommendedFlow.astro';
import { STATIC_SEO } from '@lib/seo';
import { formatDate, toDate } from '@lib/date';
import { COGNITIVE_MODE } from '@lib/kind';
import { REPO_URL, REPO_BLOB, isPublished } from '@lib/repo';

const base = import.meta.env.BASE_URL;

// ─── Patterns teaser: the first six in curated order ─────────────────────
const patterns = (await getCollection('patterns')).sort(
  (a, b) => ((a.data as any).order ?? 99) - ((b.data as any).order ?? 99),
);
const patternTeaser = [
  ...patterns.filter((p) => (p.data as any).maturity === 'Canonical').slice(0, 3),
  ...patterns.filter((p) => (p.data as any).maturity !== 'Canonical').slice(0, 3),
];

// ─── Latest changelog entry, for the hero's "what's new" line ────────────
const changelog = (await getCollection('changelog'))
  .filter((e) => isPublished(e.data as any))
  .sort((a, b) => {
    const am = toDate((a.data as any).date_modified ?? (a.data as any).date_created);
    const bm = toDate((b.data as any).date_modified ?? (b.data as any).date_created);
    return (bm ? bm.getTime() : 0) - (am ? am.getTime() : 0);
  });
const latest = changelog[0];

const canonicalKinds = ['specs', 'plans', 'prompts', 'blueprints', 'reminders', 'agent-skills', 'explorations', 'issues'] as const;
type CanonicalKind = (typeof canonicalKinds)[number];

const KIND_BLURB: Record<CanonicalKind, string> = {
  specs:          'What we plan to build, written so it can be regenerated.',
  plans:          'Sequenced, scoped work plans, between a spec and a prompt.',
  prompts:        'Step-by-step implementation, each step checkable before the next.',
  blueprints:     'Patterns proven enough to lift into the next project.',
  reminders:      'Things we keep forgetting until we wrote them down.',
  'agent-skills': 'Executable know-how agents load and follow, not just read.',
  explorations:   'Research where the destination isn\'t clear yet.',
  issues:         'The painful debugging paths and what they taught us.',
};

// Each canonical folder links to the template the kit ships for it.
const TEMPLATE: Partial<Record<CanonicalKind, string>> = {
  specs: 'spec', plans: 'plan', prompts: 'prompt', blueprints: 'blueprint',
  reminders: 'reminder', explorations: 'exploration', issues: 'issue',
};

// The experimental tier — folders whose shape is deliberately not yet
// enforced across repos. Keep in sync with the context-vigilance skill.
const EXPERIMENTAL_TIER: { slug: string; blurb: string; pattern: string }[] = [
  { slug: 'loops',     pattern: 'clarified-loops', blurb: 'Your own process, written down once, so an agent runs it the same way every time.' },
  { slug: 'handoffs',  pattern: 'handoffs',        blurb: 'End-of-session state, so the next session resumes without re-deriving it.' },
  { slug: 'decisions', pattern: 'decisions',       blurb: 'The moment intent changed: what, when, why, and the alternatives passed over.' },
  { slug: 'habits',    pattern: 'habits',          blurb: 'Recurring upkeep with a trigger and a scope: "Maintain X across Y."' },
  { slug: 'contracts', pattern: 'contracts',       blurb: 'Not suggestions: standing rules for agents, or exact interfaces data must follow.' },
];

const MODE_LABEL: Record<'prep' | 'reflection' | 'journey', string> = {
  prep: 'Prep',
  reflection: 'Reflection',
  journey: 'Journey',
};

const MODE_BLURB: Record<'prep' | 'reflection' | 'journey', string> = {
  prep: 'Deciding what to build before we build it.',
  reflection: 'Codifying what works and what doesn\'t after we built it.',
  journey: 'Capturing research and the painful debugging paths along the way.',
};
---

<BaseLayout title={STATIC_SEO.root.title} description={STATIC_SEO.root.description}>
  <main class="home">

    <!-- ─── ACT 1 — HOOK ─────────────────────────────────────────────── -->
    <section class="hero">
      <div class="container">
        <div class="pattern-band">
          <div class="pattern-band__copy">
            <div class="pattern-band__top">
              <p class="eyebrow">The whole idea</p>
              <a class="okf-stamp mono" href={`${base}patterns/okf-profile/`} title="Every context-v doc is valid Open Knowledge Format">
                <span class="okf-stamp__check" aria-hidden="true">✓</span> OKF Compliant
              </a>
            </div>
            <p class="pattern-band__claim">
              A <em>dead simple</em>, <em>highly flexible</em>, <em>surprisingly effective</em>
              pattern for context &amp; memory.
            </p>
            <p class="pattern-band__punch">
              Just add a folder to every repo: <code class="pattern-band__folder">context-v/</code>
            </p>
          </div>
          <pre class="pattern-band__tree mono" aria-label="A repo with a context-v folder beside its code"><span class="tree__dim">your-repo/</span>
<span class="tree__dim">├── src/</span>
<span class="tree__dim">├── README.md</span>
<span class="tree__hit">└── context-v/</span>   <span class="tree__note">← markdown, in git</span>
<span class="tree__sub">    ├── specs/</span>
<span class="tree__sub">    ├── explorations/</span>
<span class="tree__sub">    ├── reminders/</span>
<span class="tree__sub">    └── …</span></pre>
        </div>
      </div>

      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="folio" data-num="§ 01">The Hook</p>
          <h1 class="hero__title">
            Treat context with the same vigilance as <span class="hero__strike">code</span>
            <span class="gradient-text">— and the context becomes the parent to the code.</span>
          </h1>
          <p class="hero__lede">
            Most coding agents fail not because the code is hard, but because the
            <span class="highlight">context is missing.</span>
            You hand the agent a problem; it doesn't know your conventions, your prior
            decisions, the mistakes you made last quarter. So it guesses.
          </p>
          <p class="hero__lede hero__lede--dim">
            Treat context with vigilance — versioned, reviewed, cross-linked — and something flips.
            <strong>Code becomes regenerable.</strong> A bug fix compresses from days to minutes.
            Migrating across languages goes from "we'll plan a quarter for that" to "we did it
            Tuesday afternoon." The agent didn't get smarter. It finally has the ground it needed
            to stand on.
          </p>

          <div class="hero__search">
            <SearchBox variant="hero" />
          </div>

          <div class="hero__ctas">
            <a class="btn btn-primary" href={`${base}getting-started/`}>Get started</a>
            <a class="btn" href={`${base}#practice`}>What is this practice?</a>
          </div>
        </div>

        <aside class="hero__stats" aria-label="Install">
          <p class="eyebrow">Install in Claude Code</p>
          <div class="install">
            <CommandSteps compact steps={[
              { cmd: '/plugin marketplace add lossless-group/context-vigilance-kit' },
              { cmd: '/plugin install cv@context-vigilance-kit' },
              { cmd: '/cv:init' },
            ]} />
          </div>
          <div class="stat__row">
            <div class="stat">
              <span class="stat__num">7</span>
              <span class="stat__label mono">workflow skills</span>
            </div>
            <div class="stat">
              <span class="stat__num stat__num--thread">9</span>
              <span class="stat__label mono">templates</span>
            </div>
          </div>
          <div class="stat__row">
            <div class="stat">
              <span class="stat__num stat__num--accent">0</span>
              <span class="stat__label mono">servers or databases</span>
            </div>
            <div class="stat">
              <span class="stat__num stat__num--warm">{patterns.length}</span>
              <span class="stat__label mono">patterns</span>
            </div>
          </div>
          <p class="stats__footnote mono">
            Other agents: <a href={`${base}getting-started/`}>copy the skills in →</a>
          </p>
          {latest && (
            <p class="stats__footnote mono">
              new: <a href={`${base}changelog/${latest.id}/`}>{(latest.data as any).title}</a>
            </p>
          )}
        </aside>
      </div>

      <div class="hero__pullquote container" aria-hidden="true">
        <span class="hero__pullquote-mark mono">&gt;</span>
        <span>days to minutes &middot; quarter to Tuesday afternoon &middot; the ground it needed to stand on</span>
      </div>
    </section>

    <!-- ─── ACT 2 — PRACTICE ─────────────────────────────────────────── -->
    <section id="practice" class="practice">
      <div class="container">
        <header class="section__head">
          <p class="folio" data-num="§ 02">The Practice</p>
          <h2 class="section__title">Eight folders. Three cognitive modes.</h2>
          <p class="section__lede">
            Every file is written for three readers: the human editing it, the agent loading it
            as context tomorrow, and the public reader who lands on it cold.
            <span class="highlight">Frontmatter is a contract.</span>
            Cross-links are how attention navigates a tree too big for any one head.
          </p>
        </header>

        <div class="matrix" role="list">
          {canonicalKinds.map((kind) => {
            const mode = COGNITIVE_MODE[kind] || 'prep';
            const tpl = TEMPLATE[kind];
            return (
              <article class={`matrix__cell matrix__cell--${mode}`} role="listitem">
                <header class="matrix__head">
                  <span class="matrix__mode mono">{MODE_LABEL[mode]}</span>
                  <h3 class="matrix__kind">{kind}/</h3>
                </header>
                <p class="matrix__blurb">{KIND_BLURB[kind]}</p>
                {tpl ? (
                  <a class="matrix__example" href={`${REPO_BLOB}/agent-skills/context-vigilance/templates/${tpl}.md`} target="_blank" rel="noopener">
                    <span class="matrix__example-label mono">template</span>
                    <span class="matrix__example-title">{tpl}.md</span>
                    <span class="matrix__example-repo from-tag">/cv:new {tpl}</span>
                  </a>
                ) : (
                  <a class="matrix__example" href={`${base}patterns/folders-and-modes/`}>
                    <span class="matrix__example-label mono">pattern</span>
                    <span class="matrix__example-title">Skills born next to the code they serve</span>
                    <span class="matrix__example-repo from-tag">&lt;name&gt;/SKILL.md</span>
                  </a>
                )}
              </article>
            );
          })}
        </div>

        <div class="modes">
          <div class="modes__head">
            <span class="eyebrow">Modes</span>
          </div>
          <ul class="modes__list">
            {(['prep', 'reflection', 'journey'] as const).map((m) => (
              <li class={`modes__item modes__item--${m}`}>
                <span class="modes__dot" aria-hidden="true"></span>
                <strong class="modes__name">{MODE_LABEL[m]}</strong>
                <span class="modes__blurb">{MODE_BLURB[m]}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="tail">
          <p class="tail__lede">
            <span class="eyebrow">Experimental tier</span>
          </p>
          <p class="tail__copy">
            Five folders the practice is actively trialing. Their shape is deliberately
            not yet enforced — divergence between repos is expected and surfaced, not normalized.
            This is the on-ramp every canonical folder took: <span class="mono">plans/</span> and
            <span class="mono">agent-skills/</span> both started here.
          </p>
          <ul class="tail__list tail__list--stacked">
            {EXPERIMENTAL_TIER.map((f) => (
              <li class="tail__item">
                <a class="tail__slug mono" href={`${base}patterns/${f.pattern}/`}>{f.slug}/</a>
                <span class="tail__blurb">{f.blurb}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="tail">
          <p class="tail__lede">
            <span class="eyebrow">In practice, also</span>
          </p>
          <ul class="tail__list">
            <li class="tail__item"><span class="tail__slug mono">extra/</span><span class="tail__count mono">scratch, gitignored</span></li>
            <li class="tail__item"><span class="tail__slug mono">sitemap/</span><span class="tail__count mono">what exists where</span></li>
            <li class="tail__item"><span class="tail__slug mono">config.md</span><span class="tail__count mono">which tool fills each role</span></li>
          </ul>
          <p class="tail__copy tail__copy--dim">
            Real-world context-v grows a long tail beyond the canonical eight. In isolation each
            folder makes sense; the discipline tolerates the tail and promotes what earns it:
            assimilation, not enforcement. See it at scale in
            <a href="https://lossless-group.github.io/context-v-corpus/" target="_blank" rel="noopener">the corpus</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ─── ACT 3 — THE FLOW ─────────────────────────────────────────── -->
    <section class="cycle-act" id="flow">
      <div class="container">
        <header class="section__head">
          <p class="folio" data-num="§ 03">The Flow</p>
          <h2 class="section__title">Our recommended flow.</h2>
          <p class="section__lede">
            Explore until the question is clear, decide, write the spec, plan it, then build:
            as a team with <code class="chip">/cv:loop</code>, or solo with
            <code class="chip">/cv:implement</code>. <span class="highlight">Then reflect</span>, and
            what the cycle taught you becomes issues, and from there reminders, blueprints, and
            agent skills the next cycle starts with.
          </p>
        </header>

        <RecommendedFlow />

        <div class="proof__cta">
          <a class="btn btn-primary" href={`${base}getting-started/#cycle`}>Walk through a first cycle →</a>
        </div>
      </div>
    </section>

    <!-- ─── ACT 4 — PATTERNS (teaser) ────────────────────────────────── -->
    <section class="proof">
      <div class="container">
        <header class="section__head">
          <p class="folio" data-num="§ 04">The Patterns</p>
          <h2 class="section__title">What years of context-v files taught us.</h2>
          <p class="section__lede">
            Some conventions settled into canon. Some are still experiments. Each one says
            <span class="highlight">why it exists</span>, so you can decide whether it fits your work.
          </p>
        </header>

        <ul class="teaser" aria-label="Patterns">
          {patternTeaser.map((p) => {
            const data = p.data as any;
            return (
              <li class="teaser__item">
                <a href={`${base}patterns/${p.id}/`}>
                  <div class="teaser__meta mono">
                    <span class="teaser__kind">{data.maturity}</span>
                    <span class="teaser__repo">{data.mode}</span>
                  </div>
                  <h3 class="teaser__title">{data.title ?? p.id}</h3>
                  {data.lede && <p class="teaser__lede">{data.lede}</p>}
                </a>
              </li>
            );
          })}
        </ul>

        <div class="proof__cta">
          <a class="btn btn-primary" href={`${base}patterns/`}>All {patterns.length} patterns →</a>
          <a class="btn" href={`${base}search/`}>Search</a>
        </div>
      </div>
    </section>

    <!-- ─── ACT 5 — FAQ ──────────────────────────────────────────────── -->
    <section class="faq" id="faq">
      <div class="container">
        <header class="section__head">
          <p class="folio" data-num="§ 05">The Questions</p>
          <h2 class="section__title">Fair questions.</h2>
        </header>

        <div class="faq__list">
          <details class="faq__item" open>
            <summary class="faq__q">
              Doesn't all that context overload the context window, raise token costs, and slow the agent down?
            </summary>
            <div class="faq__a">
              <p>
                <strong>It doesn't for us, because we don't autoload it.</strong> A context-v folder
                sits on disk until something asks for it. Context reaches the agent four ways,
                roughly in order of how often:
              </p>
              <ol class="faq__steps">
                <li>
                  <span class="faq__step-name">Pointed at.</span>
                  A <a href={`${base}patterns/handoffs/`}>handoff doc</a> in
                  <code class="chip">context-v/handoffs/</code>, or a reference to the specific docs
                  the task needs. The agent loads those, and nothing else.
                </li>
                <li>
                  <span class="faq__step-name">Found.</span>
                  The agent's own ripgrep and find scans turn up what it needs almost every time.
                </li>
                <li>
                  <span class="faq__step-name">Mapped.</span>
                  Our more complex repos keep Graphify output the agent can use to find what it
                  needs when loading docs by hand falls short, which is rare.
                </li>
                <li>
                  <span class="faq__step-name">Queried.</span>
                  Every context-v file is regularly rolled up into
                  <a href="https://lossless-group.github.io/context-v-corpus/" target="_blank" rel="noopener">a corpus</a>
                  at the pseudomonorepo root, then pushed into a Chroma vector database that every
                  project reaches over MCP. Agents query it when it's relevant.
                </li>
              </ol>
            </div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">
              Without hard checks that block a merge when docs and code drift apart, how do the docs stay true?
            </summary>
            <div class="faq__a">
              <p>
                <strong>They drift a little, and that's fine.</strong> We assume the implementation
                will diverge somewhat from its context-v docs, and treat that as natural rather than
                as a failure to block.
              </p>
              <p>
                The <a href={`${base}patterns/three-date-families/`}>date fields</a> in the frontmatter
                make hard checks mostly moot. A doc that's old and hasn't been modified or versioned
                recently isn't autoloaded into a session, so in practice it doesn't collide with
                current work.
              </p>
              <p>
                During <strong>Reflect</strong>, we update the docs a cycle used to match what was
                actually built. Some projects also keep a <code class="chip">sitemap/</code> folder,
                and we're trying a <code class="chip">mirrors/</code> folder that describes the
                current state of the code and application.
              </p>
              <p>
                We haven't tried a fully automated software factory that builds and maintains code
                with no human oversight, and we're not sure it's a good idea yet. Still, each
                iteration gets faster and better with less oversight than the last. So maybe we're
                heading that way anyway.
              </p>
            </div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">
              "Code becomes regenerable" is a bold claim. Have you actually regenerated something real?
            </summary>
            <div class="faq__a">
              <p>
                <strong>Sort of.</strong> From the context-v docs, we've upgraded tech stacks,
                migrated between stacks and languages, and decomposed a monolith into a federated
                architecture. Each took two or three passes, with almost no prompt engineering
                beyond "Please rebuild this."
              </p>
            </div>
          </details>
          <details class="faq__item">
            <summary class="faq__q">
              Don't agents get worse with more context? With 13 folders, indexes, and handoffs, how do you keep what they read in check?
            </summary>
            <div class="faq__a">
              <p>
                <strong>Most of it never gets read in a given session</strong>, since nothing is
                autoloaded (see the first question). Where we do see trouble is when a long session
                truly fills the context window. The model gets something like anxiety, the closest
                human analogy: iteration slows, mistakes increase, and randomness creeps in.
              </p>
              <p>
                So we stop implementing, co-write a <a href={`${base}patterns/handoffs/`}>handoff
                doc</a>, close the session, and start fresh. It works, for reasons we don't fully
                understand, a bit like rebooting an old Windows PC.
              </p>
            </div>
          </details>
        </div>
      </div>
    </section>

    <!-- ─── ACT 6 — INVITATION ───────────────────────────────────────── -->
    <section class="invite">
      <div class="container">
        <header class="section__head section__head--centered">
          <p class="folio" data-num="§ 06">The Invitation</p>
          <h2 class="section__title">A common pattern, openly shared.</h2>
          <p class="section__lede">
            We've used this context-v pattern across 40+ repos. We like it: for us it has worked
            better than popular variants like <span class="highlight">Spec Kit and OpenSpec</span>.
            Steal what you like, abandon what you don't. Make it your own. MPL-2.0 license.
          </p>
        </header>

        <div class="invite__grid">
          <article class="invite__card">
            <p class="invite__audience eyebrow">For developers</p>
            <h3 class="invite__cta-title">Install the plugin.</h3>
            <p class="invite__cta-body">
              Two commands in Claude Code, or copy the skills into any agent that reads them.
              No server, no database, no config.
            </p>
            <a class="btn btn-primary" href={`${base}getting-started/`}>Get started →</a>
          </article>

          <article class="invite__card">
            <p class="invite__audience eyebrow">For practitioners</p>
            <h3 class="invite__cta-title">Read the patterns.</h3>
            <p class="invite__cta-body">
              {patterns.length} conventions and experiments, each with its reason. Lift what's
              useful. The vocabulary is yours to use.
            </p>
            <a class="btn" href={`${base}patterns/`}>The patterns →</a>
          </article>

          <article class="invite__card">
            <p class="invite__audience eyebrow">For the curious</p>
            <h3 class="invite__cta-title">See it at scale.</h3>
            <p class="invite__cta-body">
              Our own work: 1,000+ context-v docs across 40 projects, in
              <code class="chip">the corpus</code>. Fellow travelers:
              <code class="chip">agents.md</code>,
              <code class="chip">llms.txt</code>,
              <code class="chip">spec-kit</code>.
            </p>
            <a class="btn" href="https://lossless-group.github.io/context-v-corpus/" target="_blank" rel="noopener">The corpus →</a>
          </article>
        </div>

        <p class="invite__sign">
          <span class="mono">— Build with us, build alongside us, or build your own. <a href={REPO_URL} target="_blank" rel="noopener">GitHub →</a></span>
        </p>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ─── Section-level shared chrome ─────────────────────────────────── */
  .home > section {
    padding: var(--space-16) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .home > section:last-child { border-bottom: 0; }

  .section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
    max-width: 880px;
  }
  .section__head--centered {
    align-items: center;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .section__title {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    margin: var(--space-2) 0 var(--space-3);
    letter-spacing: -0.03em;
  }
  .section__lede {
    color: var(--color-text-soft);
    font-size: 1.04rem;
    line-height: 1.65;
    max-width: 70ch;
  }
  .section__lede strong { color: var(--color-text); font-weight: 600; }
  .section__lede em {
    color: var(--color-text);
    font-style: italic;
  }

  /* ─── Hero (Act 1) ────────────────────────────────────────────────── */
  .hero {
    padding-top: var(--space-20) !important;
    padding-bottom: var(--space-20) !important;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
    gap: var(--space-12);
    align-items: start;
  }
  @media (max-width: 980px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }

  .hero__title {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    margin: var(--space-3) 0 var(--space-6);
  }
  .hero__strike {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-accent-warm);
    color: var(--color-text-dim);
  }
  .hero__lede {
    font-family: var(--font__sans);
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--color-text-soft);
    max-width: 60ch;
    margin-top: var(--space-4);
  }
  .hero__lede--dim {
    color: var(--color-text-dim);
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
    margin-top: var(--space-5);
  }
  .hero__lede strong { color: var(--color-text); }

  .hero__search {
