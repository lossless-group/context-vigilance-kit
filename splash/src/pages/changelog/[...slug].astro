---
import { getCollection } from 'astro:content';
import AstroMarkdown from '@components/markdown/AstroMarkdown.astro';
import Sources from '@components/markdown/Sources.astro';
import { renderable } from '@lib/markdown';
import BaseLayout from '@layouts/BaseLayout.astro';
import DocEntry from '@components/DocEntry.astro';
import { toDate } from '@lib/date';
import { isPublished, REPO_BLOB } from '@lib/repo';

export async function getStaticPaths() {
  const all = await getCollection('changelog');
  return all
    .filter((e) => isPublished(e.data as any))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { tree, citations } = await renderable(entry.body);
const data = entry.data as any;
const base = import.meta.env.BASE_URL;
const path = `changelog/${entry.id}.md`;
---

<BaseLayout
  title={data.title ?? entry.id}
  description={data.lede ?? data.summary}
  ogType="article"
  publishedTime={toDate(data.date_created)?.toISOString()}
  modifiedTime={toDate(data.date_modified)?.toISOString()}
  tags={data.tags}
>
  <DocEntry
    data={data}
    id={entry.id}
    kind="Changelog"
    backHref={`${base}changelog/`}
    backLabel="Changelog"
    path={path}
    sourceUrl={`${REPO_BLOB}/${path}`}
  >
    <AstroMarkdown node={tree} />
    {citations.length > 0 && <Sources citations={citations} />}
  </DocEntry>
</BaseLayout>
