---
import BaseLayout from '@layouts/BaseLayout.astro';
import SearchBox from '@components/SearchBox.astro';
import { STATIC_SEO } from '@lib/seo';

// The corpus has its own search over every public context-v doc in the tree.
// The handoff link carries whatever the reader typed here, via ?q=.
const CORPUS_SEARCH = 'https://lossless-group.github.io/context-v-corpus/search/';
---

<BaseLayout title={STATIC_SEO.search.title} description={STATIC_SEO.search.description}>
  <main class="search-page">
    <div class="container-narrow">
      <header class="search-page__head">
        <p class="folio" data-num="§ 07">Find anything</p>
        <h1 class="search-page__title">Search the kit</h1>
        <p class="search-page__lede">
          Indexed across the patterns, the changelog, and the kit's own context-v docs. Filter by
          <span class="chip">kind</span> or
          <span class="chip">tag</span>. Press
          <kbd class="mono">/</kbd> from anywhere to focus the header search box.
        </p>
      </header>

      <SearchBox variant="full" autoFocus />

      <p class="search-page__handoff">
        Not here? The corpus has 1,000+ context-v docs from the Lossless Group's own projects.
        <a href={CORPUS_SEARCH} data-corpus-handoff target="_blank" rel="noopener">Search the corpus →</a>
      </p>

      <p class="search-page__hint mono">
        Search runs on a static index built at deploy time. In <code>astro dev</code>
        the index isn't generated — run <code>pnpm build &amp;&amp; pnpm preview</code>
        to test locally.
      </p>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ CORPUS_SEARCH }}>
  // Keep the handoff link in step with the query (SearchBox emits search:query).
  document.addEventListener('search:query', (e) => {
    const link = document.querySelector('[data-corpus-handoff]');
    if (!(link instanceof HTMLAnchorElement)) return;
    const q = typeof e.detail === 'string' ? e.detail : '';
    link.href = q ? `${CORPUS_SEARCH}?q=${encodeURIComponent(q)}` : CORPUS_SEARCH;
    link.textContent = q ? `Search the corpus for “${q}” →` : 'Search the corpus →';
  });
</script>

<style>
  .search-page { padding: var(--space-12) 0 var(--space-24); }
  .search-page__head {
    margin-bottom: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .search-page__title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin: var(--space-2) 0 var(--space-3);
  }
  .search-page__lede {
    font-size: 1.02rem;
    color: var(--color-text-soft);
    line-height: 1.6;
    max-width: 60ch;
  }
  .search-page__lede kbd {
    font-size: 0.78rem;
    padding: 1px 7px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-soft);
    color: var(--color-text);
  }
  .search-page__handoff {
    margin-top: var(--space-6);
    color: var(--color-text-soft);
  }
  .search-page__handoff a { white-space: nowrap; }
  .search-page__hint {
    margin-top: var(--space-8);
    color: var(--color-text-faint);
    font-size: 0.78rem;
  }
  .search-page__hint code {
    font-family: var(--font__mono);
    background: color-mix(in oklab, var(--color-text) 5%, transparent);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
  }
</style>
