---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('corpus');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data as any;

const title = data.title || entry.id;
const lede = data.lede || data.description || data.summary;
const tags: string[] = data.tags || [];
const authors: string[] = data.authors || [];
const augmentedWith: string[] = data.augmented_with || [];
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${title} · Context Vigilance`} description={lede}>
  <main class="container doc">
    <p class="folio mono dim">
      <a href={`${base}`}>← All context</a>
      {data.source_repo_slug && (
        <>
          {' / '}
          <span>{data.source_repo_slug}</span>
        </>
      )}
    </p>

    <header class="doc__head">
      <h1>{title}</h1>
      {lede && <p class="doc__lede soft">{lede}</p>}

      <dl class="doc__meta">
        {data.source_relative_path && (
          <>
            <dt>Path</dt>
            <dd class="mono dim">{data.source_relative_path}</dd>
          </>
        )}
        {data.status && (
          <>
            <dt>Status</dt>
            <dd>{data.status}</dd>
          </>
        )}
        {data.semantic_version && (
          <>
            <dt>Version</dt>
            <dd class="mono">{data.semantic_version}</dd>
          </>
        )}
        {data.date_modified && (
          <>
            <dt>Modified</dt>
            <dd class="mono dim">{new Date(data.date_modified).toISOString().slice(0, 10)}</dd>
          </>
        )}
        {authors.length > 0 && (
          <>
            <dt>Authors</dt>
            <dd>{authors.join(', ')}</dd>
          </>
        )}
        {augmentedWith.length > 0 && (
          <>
            <dt>Augmented with</dt>
            <dd class="dim">{augmentedWith.join(', ')}</dd>
          </>
        )}
        {tags.length > 0 && (
          <>
            <dt>Tags</dt>
            <dd class="mono dim">{tags.join(' · ')}</dd>
          </>
        )}
      </dl>
    </header>

    <article class="doc__body">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
  .doc {
    max-width: 780px;
    padding: var(--space-8) var(--space-6) var(--space-12);
  }
  .folio {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-6);
  }
  .doc__head {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--c-border);
  }
  .doc__head h1 {
    margin: 0 0 var(--space-4);
  }
  .doc__lede {
    font-size: 1.1rem;
    line-height: 1.55;
    margin: 0 0 var(--space-6);
    max-width: 65ch;
  }
  .doc__meta {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-2) var(--space-4);
    font-size: 0.9rem;
    margin: 0;
  }
  .doc__meta dt {
    color: var(--c-text-dim);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-top: 0.18em;
  }
  .doc__meta dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .doc__body {
    font-size: 1rem;
    line-height: 1.65;
  }
  .doc__body :global(h1),
  .doc__body :global(h2),
  .doc__body :global(h3) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .doc__body :global(p) {
    margin: 0 0 var(--space-4);
  }
  .doc__body :global(ul),
  .doc__body :global(ol) {
    padding-left: var(--space-6);
  }
  .doc__body :global(li) {
    margin-bottom: var(--space-2);
  }
  .doc__body :global(pre) {
    background: var(--c-code-bg);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    border: 1px solid var(--c-border);
  }
  .doc__body :global(blockquote) {
    border-left: 3px solid var(--c-accent);
    margin: 0 0 var(--space-4);
    padding-left: var(--space-4);
    color: var(--c-text-soft);
  }
  .doc__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-4);
    font-size: 0.95rem;
  }
  .doc__body :global(th),
  .doc__body :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--c-border);
    text-align: left;
  }
  .doc__body :global(th) {
    color: var(--c-text-soft);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .doc__body :global(a) {
    color: var(--c-accent);
  }
  .doc__body :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
